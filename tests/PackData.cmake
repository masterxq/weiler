# weiler-pack-data without real game data: a fake game folder with lower case names (one empty file per line of
# gamedata.list) somewhere below the source folder must become a package with the upper case names; a folder
# without game data must be rejected.
# Variables: PACKER (script), LIST (gamedata.list), WORK (working folder)

find_program(DPKG_DEB dpkg-deb)
find_program(BASH bash)
if(NOT DPKG_DEB OR NOT BASH)
    message(STATUS "dpkg-deb or bash not found, skipping")
    return()
endif()
file(REMOVE_RECURSE "${WORK}")
set(game "${WORK}/source/Spiele/Gold Edition/s2")
file(STRINGS "${LIST}" lines REGEX "^[!?]?[A-Z]")
foreach(line IN LISTS lines)
    string(REGEX REPLACE "^[!?]" "" line "${line}")
    string(REPLACE "*" "x" line "${line}")
    string(REPLACE "?" "0" line "${line}")
    string(TOLOWER "${line}" line)
    get_filename_component(dir "${game}/${line}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${game}/${line}" "")
endforeach()
file(WRITE "${game}/setup.exe" "")
file(MAKE_DIRECTORY "${WORK}/out" "${WORK}/empty/nothing")

set(ENV{LANG} C.UTF-8)
set(ENV{WEILER_APPDATA} "")
execute_process(COMMAND "${BASH}" "${PACKER}" --source "${WORK}/source" --output "${WORK}/out"
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "weiler-pack-data failed (${rc}):\n${out}\n${err}")
endif()
set(deb "${WORK}/out/weiler-data_1.0_all.deb")
execute_process(COMMAND "${DPKG_DEB}" -c "${deb}" RESULT_VARIABLE rc OUTPUT_VARIABLE contents)
foreach(f DATA/RESOURCE.DAT DATA/MBOB/ROM_Z.LST DATA/MBOB/X_ICON.LST GFX/PALETTE/PAL5.BBM DATA/MIS0BOBS.LST)
    if(NOT contents MATCHES "usr/share/games/weiler-data/S2/${f}\n")
        message(FATAL_ERROR "${f} missing in the package:\n${contents}")
    endif()
endforeach()
if(contents MATCHES "SETUP" OR NOT contents MATCHES "root/root")
    message(FATAL_ERROR "unexpected content or owner:\n${contents}")
endif()
execute_process(COMMAND "${BASH}" "${PACKER}" --source "${WORK}/empty" --output "${WORK}/out"
                RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 1)
    message(FATAL_ERROR "a folder without game data was not rejected (${rc})")
endif()
message(STATUS "weiler-pack-data: ok")
